# Maven / Java Build Output
target/
*.class
*.jar
*.war

# Rust / Cargo Build Output
core-rust/target/
**/*.rs.bk

# Environment Variables & Session Secrets
.env
.pawapay-session
.pawapay-imprint

# Logs & Temporary Execution Files
logs/
*.log
getTree.txt
test.txt
 
# IDEs and OS Specifics
.idea/
.vscode/
*.iml
.DS_Store

# Strictly ignore the proprietary Rust engine source
core-rust/

# Web resources folder
src/main/resources/web/

# VM bytecode and opcodes
src/main/resources/com/katorymnd/pawapay/sdk/utils/vm/bytecode.bin
src/main/resources/com/katorymnd/pawapay/sdk/utils/vm/opcodes.json

# Ignore all version 2 Java files
src/main/java/com/katorymnd/pawapay/sdk/**/*2.java
# Ignore entire direct examples folder
src/main/java/com/katorymnd/pawapay/examples/direct/
src/main/java/com/katorymnd/pawapay/examples/web/