<?xml version="1.0" encoding="UTF-8"?>
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">

    <!-- 
      Suppress Jetty 11.0.25 Vulnerabilities 
      Reason: Jetty 11.0.28 (the fixed version per NVD) is not yet available in Maven Central.
      We are using the latest stable release (11.0.25) provided by Javalin 6.3.0.
    -->
    <suppress>
        <notes><![CDATA[
        Suppressing CVEs for Jetty 11.0.25. 
        CVE-2026-2332 (Critical), CVE-2025-5115 (High), CVE-2026-5795 (High).
        Fix version 11.0.28 is not yet published.
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.eclipse\.jetty(\.websocket)?/.*@11\.0\.25$</packageUrl>
        <cve>CVE-2026-2332</cve>
        <cve>CVE-2025-5115</cve>
        <cve>CVE-2026-5795</cve>
        <cve>CVE-2025-11143</cve>
    </suppress>

    <!-- 
      Suppress Kotlin Stdlib False Positive 
      Reason: CVE-2020-29582 affects the Kotlin Compiler, not the runtime stdlib.
    -->
    <suppress>
        <notes><![CDATA[
        CVE-2020-29582 is a false positive for kotlin-stdlib. 
        It affects the compiler's temporary file creation, not the runtime library.
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.jetbrains\.kotlin/kotlin-stdlib.*$</packageUrl>
        <cve>CVE-2020-29582</cve>
    </suppress>

</suppressions>